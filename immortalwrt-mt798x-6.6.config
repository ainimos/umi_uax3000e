# 目标平台 & 机型（仅EMMC）
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_umi_uax3000e_emmc=y

# 启用6.12内核
CONFIG_LINUX_6_12=y
CONFIG_KERNEL_MEMORY_LIMIT=1024

# EMMC文件系统
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# 生成全套固件
CONFIG_TARGET_IMAGES_FACTORY=y
CONFIG_TARGET_IMAGES_SYSUPGRADE=y
CONFIG_TARGET_IMAGES_INITRAMFS=y

# MT7981无线+硬件加速
CONFIG_PACKAGE_kmod-mt7981-wifi=y
CONFIG_PACKAGE_mtwifi=y
CONFIG_PACKAGE_kmod-mtk-hnat=y
CONFIG_MTK_HNAT=y

# 基础配置
CONFIG_DEFAULT_LAN_IPADDR="192.168.1.1"
CONFIG_DEFAULT_LAN_NETMASK="255.255.255.0"
CONFIG_DEFAULT_HOSTNAME="ImmortalWrt"
CONFIG_DEFAULT_PASSWORD=""
CONFIG_LUCI_LANG_zh_cn=y

# 基础LuCI组件
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-network=y
CONFIG_PACKAGE_luci-system=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
